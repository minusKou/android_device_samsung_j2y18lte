/system       ext4     /dev/block/platform/soc/7824900.sdhci/by-name/system       flags=display=system
/data         ext4     /dev/block/platform/soc/7824900.sdhci/by-name/userdata     flags=display=data
/boot         emmc     /dev/block/bootdevice/by-name/boot                         flags=display=boot
/recovery     emmc     /dev/block/bootdevice/by-name/recovery                     flags=display=recovery
/efs          ext4     /dev/block/bootdevice/by-name/efs                          flags=display=efs
/misc         emmc     /dev/block/bootdevice/by-name/misc                         flags=display=misc
/cache        ext4     /dev/block/bootdevice/by-name/cache                        flags=display=cache
auto          vfat     /devices/soc/7864900.sdhci/mmc_host*                       flags=display=auto
auto          auto     /devices/soc/78db000.usb/msm_hsusb_host*                   flags=display=auto
